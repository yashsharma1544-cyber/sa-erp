# Supabase → Project Settings → API (new SA ERP project)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# Optional. On Vercel the production address is detected automatically.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server only. Random 32+ character string used to derive field users' hidden
# login passwords. Generate once; changing it logs every field phone out.
FIELD_AUTH_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-STRING
